---
/**
 * TechStats.astro
 *
 * 统计数据模块（HUD 仪表盘风格）。
 */
import { Icon } from "astro-icon/components";
import "./tech-stats.css";
import scriptUrl from "./tech-stats.ts?url";

interface StatItem {
	icon: string;
	target: number;
	label: string;
	url?: string;
}

interface Props {
	stats: StatItem[];
	hue?: number;
}
const { stats, hue = 260 } = Astro.props;
---

<section class="tech-stats" style={`--hue: ${hue};`}>
	<div class="ts-grid">
		{stats.map((s) => {
			const Tag = (s.url ? "a" : "div") as any;
			return (
				<Tag
					class="ts-card reveal"
					href={s.url}
					data-target={s.target}
					{...(s.url ? { "data-ripple": "" } : {})}
				>
					<span class="ts-cor tl"></span>
					<span class="ts-cor tr"></span>
					<span class="ts-cor bl"></span>
					<span class="ts-cor br"></span>

					<div class="ts-head">
						<span class="ts-icon">
							<Icon name={s.icon} />
						</span>
						<span class="ts-label">{s.label}</span>
					</div>

					<div class="ts-number" aria-label={`${s.target}`}>
						<span class="ts-num-chars">{s.target}</span>
					</div>

					<div class="ts-bar">
						<span class="ts-bar-fill"></span>
					</div>
				</Tag>
			);
		})}
	</div>
</section>

<script is:inline>
	function initTechStats() {
		var section = document.querySelector(".tech-stats");
		if (!section || section.dataset.bound) return;
		section.dataset.bound = "1";

		var cards = Array.from(section.querySelectorAll(".ts-card"));
		var reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

		var animate = function (card) {
			var target = Number(card.dataset.target || "0");
			var numEl = card.querySelector(".ts-num-chars");
			var bar = card.querySelector(".ts-bar-fill");
			if (!numEl || !bar) return;

			bar.style.transformOrigin = "0 50%";
			bar.style.width = "100%";

			if (reduceMotion || target <= 0) {
				numEl.textContent = String(target);
				bar.style.transform = "scaleX(" + Math.min(1, target > 0 ? 1 : 0) + ")";
				return;
			}

			// 从 0 动画到 target
			numEl.textContent = "0";
			var DURATION = 1400;
			var start = performance.now();
			var easeOut = function (t) { return 1 - Math.pow(1 - t, 3); };

			var frame = function (now) {
				var t = Math.min(1, (now - start) / DURATION);
				var val = Math.round(target * easeOut(t));
				numEl.textContent = String(val);
				var progress = 0.35 + 0.65 * (val / Math.max(1, target));
				bar.style.transform = "scaleX(" + Math.min(1, progress) + ")";
				if (t < 1) requestAnimationFrame(frame);
			};
			requestAnimationFrame(frame);
		};

		var io = new IntersectionObserver(
			function (entries) {
				for (var i = 0; i < entries.length; i++) {
					if (entries[i].isIntersecting) {
						animate(entries[i].target);
						io.unobserve(entries[i].target);
					}
				}
			},
			{ threshold: 0.2 }
		);
		cards.forEach(function (c) { io.observe(c); });

		cards.forEach(function (card) {
			if (!(card instanceof HTMLAnchorElement)) return;
			card.addEventListener("click", function (ev) {
				var rect = card.getBoundingClientRect();
				var r = document.createElement("span");
				r.className = "ts-ripple";
				var size = Math.max(rect.width, rect.height);
				r.style.width = size + "px";
				r.style.height = size + "px";
				r.style.left = (ev.clientX - rect.left) + "px";
				r.style.top = (ev.clientY - rect.top) + "px";
				card.appendChild(r);
				setTimeout(function () { r.remove(); }, 800);
			}, { passive: true });
		});
	}

	initTechStats();
	document.addEventListener("swup:contentReplaced", initTechStats);
</script>
