---
import { Icon } from "astro-icon/components";

interface Category {
	name: string;
	count: number;
	url: string;
}
interface Props {
	categories: Category[];
	hue: number;
	limit?: number;
}
const { categories, hue, limit = 12 } = Astro.props;
const list = categories.slice(0, limit);
---

<section class="portal-section" style={`--hue: ${hue};`}>
	<h2 class="portal-title reveal"><Icon name="material-symbols:folder-open-rounded" /> 分类</h2>
	<div class="cats-list reveal">
		{list.map((cat) => (
			<a href={cat.url} class="cat-pill">
				<span>{cat.name}</span>
				<i>{cat.count}</i>
			</a>
		))}
	</div>
</section>

<style>
	.portal-section {
		max-width: var(--page-width, 75rem);
		margin: 0 auto;
		padding: 3rem 1.5rem;
	}
	.portal-title {
		font-size: clamp(1.5rem, 4vw, 2rem);
		font-weight: 700;
		margin-bottom: 1.5rem;
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}
	.cats-list {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
	}
	.cat-pill {
		display: inline-flex;
		align-items: center;
		gap: 0.5em;
		padding: 0.5em 1.1em;
		border-radius: 999px;
		font-size: 0.9rem;
		background: hsl(var(--hue) 50% 50% / 0.08);
		border: 1px solid hsl(var(--hue) 50% 50% / 0.15);
		transition: all 0.3s;
	}
	.cat-pill:hover {
		background: hsl(var(--hue) 80% 50%);
		color: #fff;
		transform: translateY(-3px);
		box-shadow: 0 6px 18px hsl(var(--hue) 80% 50% / 0.3);
	}
	.cat-pill i {
		font-style: normal;
		font-size: 0.8em;
		opacity: 0.6;
	}
	.reveal {
		opacity: 0;
		transform: translateY(30px);
		transition: opacity 0.7s ease, transform 0.7s ease;
	}
	.reveal.is-visible {
		opacity: 1;
		transform: translateY(0);
	}
	@media (prefers-reduced-motion: reduce) {
		.reveal { opacity: 1; transform: none; }
	}
</style>
