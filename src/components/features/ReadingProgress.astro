---
// 文章阅读进度条：右侧竖向发光轨道 + 百分比气泡，仅在文章页（存在 #post-container）显示。
// 顶部横向进度条已被 Swup 导航进度占用（#progress-bar），故采用右侧竖向设计避免冲突。
// 配置见 src/config/effectsConfig.ts 的 readingProgressConfig。
import { readingProgressConfig } from "@/config";
---

{
	readingProgressConfig.enable && (
		<div id="reading-progress" aria-hidden="true">
			<div class="rp-track">
				<div class="rp-fill" />
			</div>
			<div class="rp-label">0%</div>
		</div>
	)
}

<style>
	#reading-progress {
		position: fixed;
		right: 20px;
		top: 50%;
		translate: 0 -50%;
		z-index: 9990;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 10px;
		pointer-events: none;
		opacity: 0;
		translate: 12px -50%;
		transition:
			opacity 0.4s ease,
			translate 0.4s cubic-bezier(0.22, 1, 0.36, 1);
	}
	#reading-progress.visible {
		opacity: 1;
		translate: 0 -50%;
	}
	@media (max-width: 768px) {
		#reading-progress {
			display: none;
		}
	}
	.rp-track {
		position: relative;
		width: 4px;
		height: 38vh;
		min-height: 180px;
		border-radius: 999px;
		background: color-mix(in oklch, var(--primary) 12%, transparent);
		overflow: hidden;
	}
	.rp-fill {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 0%;
		border-radius: inherit;
		background: linear-gradient(
			180deg,
			var(--primary) 0%,
			color-mix(in oklch, var(--primary) 55%, #bb9af7) 60%,
			#f7768e 100%
		);
		box-shadow: 0 0 10px color-mix(in oklch, var(--primary) 60%, transparent);
		/* 由 JS 写入 --rp-progress（0-1），避免频繁布局 */
		scale: var(--rp-progress, 0) 1;
		transform-origin: top;
		will-change: scale;
	}
	.rp-label {
		font-size: 0.68rem;
		font-weight: 600;
		letter-spacing: 0.02em;
		color: color-mix(in oklch, var(--primary) 85%, var(--main-text));
		text-shadow: 0 0 8px color-mix(in oklch, var(--primary) 35%, transparent);
		font-variant-numeric: tabular-nums;
	}
</style>

<script>
	import { readingProgressConfig } from "@/config";

	if (readingProgressConfig.enable) {
		const bar = document.getElementById("reading-progress");
		const fill = bar?.querySelector<HTMLElement>(".rp-fill");
		const label = bar?.querySelector<HTMLElement>(".rp-label");

		if (bar && fill && label) {
			// 应用配置渐变与层级
			if (readingProgressConfig.gradient) {
				fill.style.background = readingProgressConfig.gradient;
			}
			if (readingProgressConfig.height > 0) {
				const track = bar.querySelector<HTMLElement>(".rp-track");
				if (track) track.style.width = `${readingProgressConfig.height + 1}px`;
			}
			bar.style.zIndex = String(readingProgressConfig.zIndex);

			let ticking = false;

			function update() {
				ticking = false;
				// 仅文章页显示（Swup 切页后 #post-container 会随之出现/消失）
				const postContainer = document.getElementById("post-container");
				if (!postContainer) {
					bar!.classList.remove("visible");
					return;
				}
				const doc = document.documentElement;
				const max = doc.scrollHeight - window.innerHeight;
				const progress = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
				fill!.style.setProperty("--rp-progress", progress.toFixed(4));
				label!.textContent = `${Math.round(progress * 100)}%`;
				// 滚动超过一屏后才显示，避免刚进文章就出现
				bar!.classList.toggle("visible", window.scrollY > 80);
			}

			function onScroll() {
				if (!ticking) {
					ticking = true;
					requestAnimationFrame(update);
				}
			}

			window.addEventListener("scroll", onScroll, { passive: true });
			window.addEventListener("resize", onScroll, { passive: true });

			// Swup 兼容：监听 DOM 变化（换页后 #post-container 出现/消失时重新计算）
			const observer = new MutationObserver(onScroll);
			observer.observe(document.body, { childList: true, subtree: false });
			// 首次载入 + 脚本加载于正文之后的兜底
			update();
		}
	}
</script>
