---
/**
 * CatStats.astro
 *
 * 统计卡片：圆润暖色卡片 + 进入视口时数字滚动。
 */
import { Icon } from "astro-icon/components";

interface StatItem {
	icon: string;
	target: number;
	label: string;
	url?: string;
}
interface Props {
	stats: StatItem[];
}
const { stats } = Astro.props;
---

<section class="cat-stats">
	<div class="stats-grid">
		{stats.map((s, i) => {
			const Tag = s.url ? "a" : "div";
			return (
				<Tag
					class="stat-card reveal"
					style={`--delay:${i * 80}ms;--tone:${i};`}
					href={s.url}
					data-target={s.target}
				>
					<span class="stat-icon"><Icon name={s.icon} /></span>
					<span class="stat-num">{s.target}</span>
					<span class="stat-label">{s.label}</span>
				</Tag>
			);
		})}
	</div>
</section>

<script is:inline>
	function initCatStats() {
		var section = document.querySelector(".cat-stats");
		if (!section || section.dataset.bound) return;
		section.dataset.bound = "1";

		var reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
		var cards = Array.from(section.querySelectorAll(".stat-card"));

		function countUp(card) {
			var target = Number(card.dataset.target || "0");
			var el = card.querySelector(".stat-num");
			if (!el || reduceMotion || target <= 0) return;
			var start = performance.now();
			el.textContent = "0";
			function frame(now) {
				var t = Math.min(1, (now - start) / 1200);
				el.textContent = String(Math.round(target * (1 - Math.pow(1 - t, 3))));
				if (t < 1) requestAnimationFrame(frame);
			}
			requestAnimationFrame(frame);
		}

		var io = new IntersectionObserver(function (entries) {
			for (var i = 0; i < entries.length; i++) {
				if (entries[i].isIntersecting) {
					countUp(entries[i].target);
					io.unobserve(entries[i].target);
				}
			}
		}, { threshold: 0.3 });
		cards.forEach(function (c) { io.observe(c); });
	}

	initCatStats();
</script>
