---
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import { getLqipProps } from "@/utils/lqip-utils";
import { url } from "@/utils/url-utils";

interface Props {
	id: string;
	name: string;
	cover: string;
	/** 压在封面下面露出边角的照片（最多 2 张），不够时用空白相纸 */
	stack?: string[];
	description?: string;
	date?: string;
	location?: string;
	tags?: string[];
	photoCount: number;
	encrypted?: boolean;
}

const {
	id,
	name,
	cover,
	stack = [],
	description,
	date,
	location,
	tags,
	photoCount,
	encrypted,
} = Astro.props;

// LQIP 渐变占位
const lqipProps = cover ? getLqipProps(cover, undefined, true) : { style: "" };
// 加密相册不露出里面的照片，只叠空白相纸
const layers = encrypted ? [] : stack;
---

<a
  href={url(`/gallery/${id}/`)}
  data-tags={tags?.join(",") || ""}
  class="album-card group relative block"
>
  <div class="album-stack relative aspect-4/3">
    {/* 一叠照片：后两层斜着露出边角，悬停时像扑克牌一样散开 */}
    <div class="stack-layer stack-back" aria-hidden="true">
      {layers[1] && <img src={layers[1]} alt="" loading="lazy" decoding="async" />}
    </div>
    <div class="stack-layer stack-mid" aria-hidden="true">
      {layers[0] && <img src={layers[0]} alt="" loading="lazy" decoding="async" />}
    </div>

    <div class="stack-top absolute inset-0 overflow-hidden rounded-xl">
      {cover ? (
        <>
          <div class="lqip-placeholder absolute inset-0 pointer-events-none" style={lqipProps.style} aria-hidden="true"></div>
          <img
            src={cover}
            alt={name}
            class="w-full h-full object-cover pointer-events-none opacity-0 transition-all duration-700 ease-out group-hover:scale-105"
            loading="lazy"
            decoding="async"
          />
        </>
      ) : (
        <div class="w-full h-full bg-gray-200 dark:bg-gray-700 flex items-center justify-center">
          <div class="text-gray-400 text-5xl">&#x1f4f7;</div>
        </div>
      )}

      <!-- Photo count badge -->
      <div class="absolute top-2 right-2 px-2 py-1 rounded-full text-xs text-white font-medium bg-black/50 backdrop-blur-sm">
        {photoCount} {i18n(I18nKey.galleryPhotos)}
      </div>

      {/* Encrypted badge */}
      {encrypted && (
        <div class="absolute top-2 left-2 px-2 py-1 rounded-full text-xs text-white font-medium bg-black/50 backdrop-blur-sm flex items-center gap-1">
          <svg class="w-3 h-3" viewBox="0 0 24 24" fill="currentColor"><path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1s3.1 1.39 3.1 3.1v2z"/></svg>
        </div>
      )}

      <!-- Gradient overlay + info -->
      <div class="absolute inset-0 bg-linear-to-t from-black/75 via-black/15 to-transparent" />
      <div class="absolute bottom-0 left-0 right-0 p-4">
        <h3 class="font-bold text-lg text-white line-clamp-1 drop-shadow-lg">
          {name}
        </h3>

        {description && (
          <p class="text-xs text-white/75 line-clamp-1 mt-1 leading-relaxed" title={description}>
            {description}
          </p>
        )}

        <div class="flex items-center gap-3 text-xs text-white/70 mt-1.5 flex-wrap">
          {date && <span>{date}</span>}
          {location && (
            <span class="inline-flex items-center gap-0.5">
              <svg class="w-3 h-3" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5a2.5 2.5 0 010-5 2.5 2.5 0 010 5z"/></svg>
              {location}
            </span>
          )}
        </div>

        {tags && tags.length > 0 && (
          <div class="flex flex-wrap gap-1 mt-2">
            {tags.slice(0, 4).map((tag) => (
              <span class="text-[0.6rem] px-1.5 py-0.5 rounded bg-white/20 text-white/90 backdrop-blur-sm">
                {tag}
              </span>
            ))}
          </div>
        )}
      </div>
    </div>
  </div>
</a>

<style>
  .stack-layer,
  .stack-top {
    transition:
      transform 0.55s cubic-bezier(0.2, 0.8, 0.2, 1),
      box-shadow 0.55s;
  }
  /* 后面两层是「冲印出来的相片」：带一圈相纸白边 */
  .stack-layer {
    position: absolute;
    inset: 0;
    border-radius: 0.75rem;
    overflow: hidden;
    background: #fbf8f3;
    border: 6px solid #fbf8f3;
    box-shadow: 0 6px 18px rgb(0 0 0 / 0.14);
  }
  :global(.dark) .stack-layer {
    background: #2b2a30;
    border-color: #2b2a30;
  }
  .stack-layer img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 0.4rem;
  }
  .stack-back {
    transform: rotate(-6deg) translate(-3%, 2%);
  }
  .stack-mid {
    transform: rotate(4deg) translate(3%, 1%);
  }
  .stack-top {
    box-shadow: 0 10px 28px rgb(0 0 0 / 0.2);
  }

  .album-card:hover .stack-back,
  .album-card:focus-visible .stack-back {
    transform: rotate(-12deg) translate(-15%, -2%);
  }
  .album-card:hover .stack-mid,
  .album-card:focus-visible .stack-mid {
    transform: rotate(9deg) translate(15%, -3%);
  }
  .album-card:hover .stack-top,
  .album-card:focus-visible .stack-top {
    transform: translateY(-8px) rotate(-1deg);
    box-shadow: 0 22px 44px rgb(0 0 0 / 0.28);
  }
  .album-card:focus-visible {
    outline: none;
  }
  .album-card:focus-visible .stack-top {
    outline: 3px solid var(--primary);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .stack-layer,
    .stack-top {
      transition: none;
    }
  }
</style>
