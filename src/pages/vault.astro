---
/**
 * 私密页 /vault/ —— 在浏览器本地用口令解密 src/data/vault.json
 *
 * 页面和仓库里只有密文（由 pnpm vault 从 private/*.txt 加密生成，明文永远不提交）。
 * 口令只在本页内存里参与解密，不发送、不保存；解开后 5 分钟无操作自动锁定。
 * 不进导航、站点地图和站内搜索（没有 data-pagefind-body），并要求搜索引擎不收录。
 */
import MainGridLayout from "@/layouts/MainGridLayout.astro";

// vault.json 还没生成时页面照常构建，只提示先运行 pnpm vault
const found = import.meta.glob<{ default: unknown }>("../data/vault.json", {
	eager: true,
});
const vault = Object.values(found)[0]?.default ?? null;
---

<MainGridLayout title="私密" description="私密内容">
	<meta slot="head" name="robots" content="noindex, nofollow, noarchive" />

	<div class="card-base vault" data-pagefind-ignore="all">
		<script id="vault-data" type="application/json" set:html={JSON.stringify(vault)} />

		<form class="vault-lock" id="vault-lock" autocomplete="off">
			<div class="vault-icon" aria-hidden="true">🔒</div>
			<h2>这里的内容已加密</h2>
			<p class="vault-tip">输入解锁口令，在本地浏览器里解密查看。口令不会被发送或保存。</p>
			{vault ? (
				<div class="vault-row">
					<input
						id="vault-password"
						type="password"
						placeholder="解锁口令"
						autocomplete="off"
						spellcheck="false"
						required
					/>
					<button type="submit" id="vault-submit">解锁</button>
				</div>
			) : (
				<p class="vault-tip">还没有内容：把 txt 放进项目的 private/ 目录，运行 pnpm vault 加密后再发布。</p>
			)}
			<p class="vault-msg" id="vault-msg" role="alert"></p>
		</form>

		<div class="vault-open" id="vault-open" hidden>
			<div class="vault-bar">
				<span>已解锁 · 5 分钟无操作自动锁定</span>
				<button type="button" id="vault-relock">锁定</button>
			</div>
			<div id="vault-files"></div>
		</div>
	</div>

	<script is:inline>
		(function () {
			var root = document.querySelector(".vault");
			if (!root) return;
			var vault = JSON.parse(document.getElementById("vault-data").textContent || "null");
			var lockForm = document.getElementById("vault-lock");
			var openBox = document.getElementById("vault-open");
			var filesBox = document.getElementById("vault-files");
			var msg = document.getElementById("vault-msg");
			var input = document.getElementById("vault-password");
			var submit = document.getElementById("vault-submit");
			var idleTimer = null;
			var IDLE_MS = 5 * 60 * 1000;

			function b64(s) {
				var bin = atob(s);
				var out = new Uint8Array(bin.length);
				for (var i = 0; i < bin.length; i++) out[i] = bin.charCodeAt(i);
				return out;
			}

			async function decrypt(password) {
				var baseKey = await crypto.subtle.importKey(
					"raw",
					new TextEncoder().encode(password),
					"PBKDF2",
					false,
					["deriveKey"],
				);
				var key = await crypto.subtle.deriveKey(
					{ name: "PBKDF2", hash: "SHA-256", salt: b64(vault.salt), iterations: vault.iterations },
					baseKey,
					{ name: "AES-GCM", length: 256 },
					false,
					["decrypt"],
				);
				var plain = await crypto.subtle.decrypt(
					{ name: "AES-GCM", iv: b64(vault.iv) },
					key,
					b64(vault.data),
				);
				return JSON.parse(new TextDecoder().decode(plain));
			}

			// 用 textContent 填充，内容里即使有尖括号也只当文本显示
			function render(files) {
				filesBox.textContent = "";
				files.forEach(function (file) {
					var card = document.createElement("section");
					card.className = "vault-file";
					var title = document.createElement("h3");
					title.textContent = file.name;
					card.appendChild(title);
					file.content.split("\n").forEach(function (line) {
						var row = document.createElement("div");
						row.className = "vault-line";
						var text = document.createElement("span");
						text.textContent = line || " ";
						row.appendChild(text);
						if (line.trim()) {
							var copy = document.createElement("button");
							copy.type = "button";
							copy.textContent = "复制";
							copy.addEventListener("click", function () {
								// 「账号：xxx」这类行只复制冒号后面的值
								var m = line.match(/^[^:：]{1,12}[:：]\s*(.+)$/);
								navigator.clipboard.writeText(m ? m[1] : line).then(function () {
									copy.textContent = "已复制";
									setTimeout(function () { copy.textContent = "复制"; }, 1200);
								});
							});
							row.appendChild(copy);
						}
						card.appendChild(row);
					});
					filesBox.appendChild(card);
				});
			}

			function lock() {
				clearTimeout(idleTimer);
				filesBox.textContent = "";
				openBox.hidden = true;
				lockForm.hidden = false;
				document.removeEventListener("pointerdown", bump);
				document.removeEventListener("keydown", bump);
				if (input) input.focus();
			}

			function bump() {
				clearTimeout(idleTimer);
				// 离开本页（swup 把它换出文档）后不再计时
				if (!root.isConnected) return lock();
				idleTimer = setTimeout(lock, IDLE_MS);
			}

			if (lockForm && vault) {
				lockForm.addEventListener("submit", async function (e) {
					e.preventDefault();
					var password = input.value;
					if (!password) return;
					submit.disabled = true;
					msg.textContent = "解密中…";
					try {
						var files = await decrypt(password);
						input.value = "";
						msg.textContent = "";
						render(files);
						lockForm.hidden = true;
						openBox.hidden = false;
						document.addEventListener("pointerdown", bump);
						document.addEventListener("keydown", bump);
						bump();
					} catch (err) {
						msg.textContent = "口令不对，或内容已损坏";
						input.select();
					} finally {
						submit.disabled = false;
					}
				});
			}
			document.getElementById("vault-relock").addEventListener("click", lock);
			// 切到别的页面时清掉明文
			document.addEventListener("swup:visit:start", function onLeave() {
				document.removeEventListener("swup:visit:start", onLeave);
				lock();
			});
		})();
	</script>
</MainGridLayout>

<style is:global>
	/* 解锁后的内容是 JS 动态生成的，没有 Astro 作用域标记，所以用全局样式（都挂在 .vault 下） */
	.vault {
		padding: 2rem 1.5rem;
		min-height: 20rem;
	}
	.vault-lock {
		max-width: 26rem;
		margin: 2rem auto;
		text-align: center;
	}
	.vault-icon {
		font-size: 2.5rem;
	}
	.vault-lock h2 {
		margin: 0.5rem 0;
		font-size: 1.25rem;
		font-weight: 700;
		color: var(--deep-text, inherit);
	}
	.vault-tip {
		font-size: 0.85rem;
		opacity: 0.7;
	}
	.vault-row {
		display: flex;
		gap: 0.5rem;
		margin-top: 1rem;
	}
	.vault-row input {
		flex: 1;
		min-width: 0;
		padding: 0.6rem 0.9rem;
		border-radius: 0.75rem;
		border: 1px solid var(--line-divider, rgba(0, 0, 0, 0.12));
		background: var(--card-bg, transparent);
		color: inherit;
		font: inherit;
	}
	.vault-row input:focus {
		outline: 2px solid var(--primary);
		outline-offset: 1px;
	}
	.vault button {
		padding: 0.5rem 1rem;
		border-radius: 0.75rem;
		background: var(--primary);
		color: #fff;
		font-weight: 600;
		white-space: nowrap;
	}
	.vault button:disabled {
		opacity: 0.6;
	}
	.vault-msg {
		min-height: 1.4em;
		margin-top: 0.6rem;
		font-size: 0.85rem;
		color: #d9534f;
	}
	.vault-bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 1rem;
		font-size: 0.85rem;
		opacity: 0.85;
	}
	.vault-file {
		margin-bottom: 1.2rem;
		padding: 1rem 1.1rem;
		border-radius: 0.9rem;
		border: 1px solid var(--line-divider, rgba(0, 0, 0, 0.1));
	}
	.vault-file h3 {
		margin: 0 0 0.6rem;
		font-size: 1rem;
		font-weight: 700;
	}
	.vault-line {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.8rem;
		padding: 0.3rem 0;
		font-family: var(--font-code, monospace);
		font-size: 0.9rem;
		word-break: break-all;
	}
	.vault-line + .vault-line {
		border-top: 1px dashed var(--line-divider, rgba(0, 0, 0, 0.08));
	}
	.vault-line button {
		flex-shrink: 0;
		padding: 0.2rem 0.6rem;
		font-size: 0.75rem;
	}
</style>
