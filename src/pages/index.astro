---
/**
 * 首页 index.astro —— 便当格（bento）布局
 *
 * 一屏卡片：欢迎卡 / 时钟 / 最近文章 / 动态 / 分类标签 / 营业天数 / 日历 / 音乐 / 社交
 * 样式见 src/components/home/bento.css，配色沿用 cat-home.css。
 */
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import "@/components/home/bento.css";
import "@/components/home/cat-home.css";
import ImageWrapper from "@/components/common/ImageWrapper.astro";
import MusicPlayer from "@/components/features/MusicPlayer.astro";
import Navbar from "@/components/layout/Navbar.astro";
import {
	backgroundWallpaper,
	displaySettingsConfig,
	musicPlayerConfig,
	profileConfig,
	siteConfig,
} from "@/config";
import Layout from "@/layouts/Layout.astro";
import {
	getCategoryList,
	getSortedPostsList,
	getTagList,
} from "@/utils/content-utils";
import { getPostUrlBySlug, getTagUrl, url } from "@/utils/url-utils";

const isBannerMode = backgroundWallpaper.mode === "banner";
const isFullscreenMode = backgroundWallpaper.mode === "fullscreen";
const isOverlayMode = backgroundWallpaper.mode === "overlay";
const isWallpaperSwitchable = displaySettingsConfig.wallpaperModeSwitchable;
const navbarWidthFull = siteConfig.navbar.widthFull ?? false;
const stickyNavbar = siteConfig.navbar.stickyNavbar ?? false;

const allPosts = await getSortedPostsList();
const categories = await getCategoryList();
const tags = await getTagList();

const visiblePosts = allPosts.filter((p) =>
	import.meta.env.PROD ? !p.data.draft : true,
);

const postCount = visiblePosts.length;
const categoryCount = categories.length;
const tagCount = tags.length;
const startDate = new Date(siteConfig.siteStartDate ?? "2026-01-01");
const runningDays = Math.max(
	0,
	Math.floor((Date.now() - startDate.getTime()) / 86400000),
);

const fmt = (d: Date) =>
	`${d.getFullYear()}/${String(d.getMonth() + 1).padStart(2, "0")}/${String(d.getDate()).padStart(2, "0")}`;

const recentPosts = visiblePosts.slice(0, 5).map((p) => ({
	title: p.data.title,
	date: fmt(p.data.published),
	href: getPostUrlBySlug(p.data.slug || p.id),
}));

const dynamics = (await getCollection("dynamic"))
	.sort((a, b) => b.data.published.getTime() - a.data.published.getTime())
	.slice(0, 2)
	.map((d) => ({
		date: fmt(d.data.published),
		text: (d.body ?? "")
			.replace(/!\[[^\]]*\]\([^)]*\)/g, "")
			.replace(/[#>*`_]/g, "")
			.trim(),
	}));

// 日历高亮：有文章发布的日期（YYYY-M-D）
const postDates = visiblePosts.map((p) => {
	const d = p.data.published;
	return `${d.getFullYear()}-${d.getMonth() + 1}-${d.getDate()}`;
});

// 法定节假日与调休：构建时从 holiday-cn（整理自国务院办公厅通知）拉取今明两年，
// 直接写进页面，访客端不再请求。拉取失败就不标，日历其余部分照常显示。
// 新一年的安排（通常 11 月公布）在下次构建后生效。
type HolidayDay = { name: string; date: string; isOffDay: boolean };
const holidayCache: Map<number, HolidayDay[]> =
	((globalThis as Record<string, unknown>).__holidayCache as Map<
		number,
		HolidayDay[]
	>) ?? new Map();
(globalThis as Record<string, unknown>).__holidayCache = holidayCache;
async function loadHolidays(year: number): Promise<HolidayDay[]> {
	const hit = holidayCache.get(year);
	if (hit) return hit;
	try {
		const res = await fetch(
			`https://cdn.jsdelivr.net/gh/NateScarlet/holiday-cn@master/${year}.json`,
			{ signal: AbortSignal.timeout(8000) },
		);
		if (!res.ok) return [];
		const days = ((await res.json()) as { days?: HolidayDay[] }).days ?? [];
		holidayCache.set(year, days);
		return days;
	} catch {
		return [];
	}
}
const thisYear = new Date().getFullYear();
// { "2026-10-01": ["国庆节", 1] }，1 = 放假，0 = 调休上班
const holidays: Record<string, [string, 0 | 1]> = {};
for (const days of await Promise.all([
	loadHolidays(thisYear),
	loadHolidays(thisYear + 1),
])) {
	for (const d of days) holidays[d.date] = [d.name, d.isOffDay ? 1 : 0];
}

const notice = "喵~ 欢迎来到猫神X的猫窝：记录技术 · 分享生活 · 偶尔讲故事。";
---

<Layout
	hasWallpaper={isWallpaperSwitchable || isBannerMode || isFullscreenMode || isOverlayMode}
>

{/* 顶部导航栏（保留） */}
<div
	id="top-row"
	class="z-50 pointer-events-none relative transition-all duration-700 mx-auto"
	class:list={[
		stickyNavbar ? "h-18 fixed top-0 left-0 right-0 z-80" : "",
		navbarWidthFull ? "" : "w-full xl:w-[92vw] max-w-(--page-width) px-0 md:px-4",
	]}
>
	<div
		id="navbar-wrapper"
		class:list={["pointer-events-auto transition-all", stickyNavbar ? "" : "sticky top-0"]}
	>
		<Navbar></Navbar>
	</div>
</div>

{/* 导航栏以外的整页内容。首页 / 音乐页 / 书架页与普通页面布局不同，跳转涉及它们时 swup 整块替换这里，
    导航栏和全站播放器保持不动，音乐不中断（见 src/utils/swup-page-swap.ts） */}
<div id="swup-page" class="contents">
<div class="cat-home">
{/* 两侧装饰插画：歌川广重浮世绘（大都会博物馆开放获取，CC0），宽屏时从左右弹入 */}
<figure class="bento-side bento-side-left" aria-hidden="true">
	<img src={url("/assets/images/home/hiroshige-cat-window.jpg")} alt="" loading="eager" decoding="async" fetchpriority="low" />
</figure>
<figure class="bento-side bento-side-right" aria-hidden="true">
	<img src={url("/assets/images/home/hiroshige-plum-garden.jpg")} alt="" loading="eager" decoding="async" fetchpriority="low" />
</figure>
<main class="bento-page">
	<div class="bento-notice">
		<Icon name="material-symbols:campaign-rounded" />
		<span>{notice}</span>
	</div>

	<div class="bento-grid">
		{/* 欢迎卡 */}
		<section class="b-card b-hero">
			<div class="hero-top">
				<div class="hero-welcome">WELCOME · {siteConfig.title}</div>
				<div class="hero-avatar">
					<ImageWrapper src={profileConfig.avatar || ""} alt={profileConfig.name} class="w-full h-full" />
				</div>
			</div>
			<div class="hero-mid">
				<h1 class="hero-name">{profileConfig.name}</h1>
				<p class="hero-slogan">躬身入局，心为主理，行有尺度</p>
			</div>
			<div>
				<div class="hero-stats">
					<div><b>{postCount}</b><span>文章</span></div>
					<div><b>{categoryCount}</b><span>分类</span></div>
					<div><b>{tagCount}</b><span>标签</span></div>
				</div>
				<div class="hero-actions">
					<a class="hero-btn" href={url("/about/")}><Icon name="material-symbols:pets" />关于我</a>
					<a class="hero-btn" href={url("/articles/")}><Icon name="material-symbols:article-rounded" />看文章</a>
				</div>
			</div>
		</section>

		{/* 时钟 */}
		<section class="b-card b-clock">
			<div class="clock-time" id="bento-time">--:--<small>:--</small></div>
			<div class="clock-date" id="bento-date"></div>
			<div class="clock-weather" id="bento-weather" hidden></div>
			<div class="clock-hello" id="bento-hello">喵~</div>
		</section>

		{/* 最近写下 */}
		<section class="b-card b-recent">
			<div class="b-head">
				<h2 class="b-title">最近写下</h2>
				<a class="b-more" href={url("/articles/")}>全部文章 <Icon name="material-symbols:arrow-forward-rounded" /></a>
			</div>
			{recentPosts.length ? (
				<ul class="b-list">
					{recentPosts.map((p) => (
						<li>
							<a href={p.href}>
								<span class="li-dot"></span>
								<span class="li-text">{p.title}</span>
								<span class="li-date">{p.date.slice(5)}</span>
							</a>
						</li>
					))}
				</ul>
			) : <p class="b-empty">还没有文章</p>}
		</section>

		{/* 动态 */}
		<section class="b-card b-diary">
			<div class="b-head">
				<h2 class="b-title">日记</h2>
				<a class="b-more" href={url("/dynamic/")}>全部日记 <Icon name="material-symbols:arrow-forward-rounded" /></a>
			</div>
			{dynamics.length ? dynamics.map((d) => (
				<a class="diary-item" href={url("/dynamic/")}>
					<div class="diary-date">{d.date}</div>
					<p class="diary-body">{d.text}</p>
				</a>
			)) : <p class="b-empty">还没有日记</p>}
		</section>

		{/* 分类 / 标签 */}
		<section class="b-card b-chips">
			<div class="b-head">
				<h2 class="b-title">猫窝分区</h2>
				<a class="b-more" href={url("/categories/")}>全部 <Icon name="material-symbols:arrow-forward-rounded" /></a>
			</div>
			<div class="chip-wrap">
				{categories.slice(0, 6).map((c) => (
					<a class="chip" href={c.url}>{c.name}</a>
				))}
				{tags.slice(0, 6).map((t) => (
					<a class="chip" href={getTagUrl(t.name)}>#{t.name}</a>
				))}
			</div>
		</section>

		{/* 营业天数 */}
		<section class="b-card b-days">
			<div class="days-label">猫窝已经营业</div>
			<div class="days-num">{runningDays}<small>天</small></div>
			<div class="days-sub">自 {siteConfig.siteStartDate} 起</div>
		</section>

		{/* 日历 */}
		<section class="b-card b-cal" id="bento-cal" data-posts={JSON.stringify(postDates)} data-holidays={JSON.stringify(holidays)}>
			<div class="cal-head">
				<h2 class="b-title" id="cal-title">日历</h2>
			</div>
			<div class="cal-grid" id="cal-grid"></div>
			<div class="cal-legend">高亮 = 发过文章 · <span class="cal-badge off">休</span> 放假 · <span class="cal-badge work">班</span> 调休</div>
		</section>

		{/* 音乐：与导航栏、侧栏共用同一个播放器（MusicManager），在哪个上面操作都会同步 */}
		{musicPlayerConfig.showInSidebar !== false ? (
			<section class="b-card b-music">
				<div class="b-head">
					<h2 class="b-title">此刻的旋律</h2>
					<a class="b-more" href={url("/music/")}>音乐页 <Icon name="material-symbols:arrow-forward-rounded" /></a>
				</div>
				<MusicPlayer id="home-music-player" />
				{/* 正在播放的歌词：当前句 + 下一句，数据来自 MusicManager 的 fm:* 事件 */}
				<div class="home-lrc" id="home-lrc" aria-live="polite">
					<p class="home-lrc-cur">♪ 点一下播放，听听此刻的旋律</p>
					<p class="home-lrc-next"></p>
				</div>
			</section>
		) : (
			<a class="b-card b-music b-music-entry" href={url("/music/")}>
				<Icon class="entry-icon" name="material-symbols:music-note-rounded" />
				<div class="entry-title">此刻的旋律</div>
				<div class="entry-sub">去听听歌</div>
			</a>
		)}

		{/* 社交 */}
		<section class="b-card b-social">
			<div class="b-head"><h2 class="b-title">来找我玩</h2></div>
			<div class="social-tiles">
				{profileConfig.links.map((l) => (
					<a
						class="social-tile"
						href={l.url}
						target={/^https?:\/\//.test(l.url) ? "_blank" : undefined}
						rel="noopener noreferrer"
					>
						<Icon name={l.icon ?? "mdi:web"} />
						<span>{l.name}</span>
					</a>
				))}
			</div>
		</section>
	</div>

	<footer class="bento-footer">
		<p>&copy; {new Date().getFullYear()} {siteConfig.title} &middot; 猫猫已就位 🐾</p>
	</footer>
</main>
</div>

<script is:inline>
	function pad(n) { return String(n).padStart(2, "0"); }
	function initBento() {
		var t = document.getElementById("bento-time");
		if (!t) return;
		function tick() {
			// 经 swup 离开首页后时钟已不在文档里，停掉定时器（回到首页时本脚本会重跑、重新计时）
			if (!t.isConnected) {
				clearInterval(window.__bentoTimer);
				return;
			}
			var d = new Date();
			t.innerHTML = pad(d.getHours()) + ":" + pad(d.getMinutes()) + "<small>:" + pad(d.getSeconds()) + "</small>";
			document.getElementById("bento-date").textContent =
				d.getFullYear() + " 年 " + (d.getMonth() + 1) + " 月 " + d.getDate() + " 日 · 周" + "日一二三四五六"[d.getDay()];
			var h = d.getHours();
			document.getElementById("bento-hello").textContent =
				h < 6 ? "夜深了，早点睡喵~" : h < 11 ? "早上好喵~" : h < 14 ? "中午好，吃饭了吗~" : h < 18 ? "下午好喵~" : "晚上好喵~";
		}
		tick();
		if (window.__bentoTimer) clearInterval(window.__bentoTimer);
		window.__bentoTimer = setInterval(tick, 1000);

		// 日历
		var cal = document.getElementById("bento-cal");
		var posts = new Set(JSON.parse(cal.dataset.posts || "[]"));
		var holidays = JSON.parse(cal.dataset.holidays || "{}");
		var now = new Date(), y = now.getFullYear(), m = now.getMonth();
		document.getElementById("cal-title").textContent = y + " 年 " + (m + 1) + " 月";
		var html = "一二三四五六日".split("").map(function (c) { return '<div class="dow">' + c + "</div>"; }).join("");
		var offset = (new Date(y, m, 1).getDay() + 6) % 7;
		for (var i = 0; i < offset; i++) html += "<div></div>";
		var days = new Date(y, m + 1, 0).getDate();
		for (var d = 1; d <= days; d++) {
			var date = new Date(y, m, d);
			var key = y + "-" + pad(m + 1) + "-" + pad(d);
			var lunar = lunarOf(date);
			var festival = festivalOf(date, lunar);
			var holiday = holidays[key];
			var cls = "d";
			if (posts.has(y + "-" + (m + 1) + "-" + d)) cls += " has-post";
			if (d === now.getDate()) cls += " today";
			if (festival) cls += " festival";

			var tip = (m + 1) + " 月 " + d + " 日";
			if (lunar) tip += " · 农历" + lunar.month + lunarDayName(lunar.day);
			if (festival) tip += " · " + festival[1];
			if (holiday) {
				// 节日名与假日名相同（如国庆节当天）时不重复写
				if (!festival || festival[1] !== holiday[0]) tip += " · " + holiday[0];
				tip += holiday[1] ? "（放假）" : "（调休上班）";
			}

			var sub = festival ? festival[0] : lunar ? (lunar.day === 1 ? lunar.month : lunarDayName(lunar.day)) : "";
			html += '<div class="' + cls + '" title="' + tip + '">' +
				(holiday ? '<span class="cal-badge ' + (holiday[1] ? "off" : "work") + '">' + (holiday[1] ? "休" : "班") + "</span>" : "") +
				'<span class="dn">' + d + "</span>" +
				(sub ? '<span class="lu">' + sub + "</span>" : "") +
				"</div>";
		}
		document.getElementById("cal-grid").innerHTML = html;
	}

	// 农历：用浏览器内置的中国历（Intl，zh-CN-u-ca-chinese），不支持时返回 null 只显示公历
	var lunarFmt = null;
	try {
		lunarFmt = new Intl.DateTimeFormat("zh-CN-u-ca-chinese", { month: "long", day: "numeric" });
	} catch (e) {}
	function lunarOf(date) {
		if (!lunarFmt) return null;
		var month = "", day = 0;
		lunarFmt.formatToParts(date).forEach(function (p) {
			if (p.type === "month") month = p.value;
			if (p.type === "day") day = parseInt(p.value, 10);
		});
		return month && day ? { month: month, day: day } : null;
	}
	function lunarDayName(n) {
		var digits = "一二三四五六七八九十";
		if (n === 10) return "初十";
		if (n === 20) return "二十";
		if (n === 30) return "三十";
		return ["初", "十", "廿"][Math.floor(n / 10)] + digits[(n % 10) - 1];
	}

	// 节日：[格子里的两字简称, 完整名称]；农历节日优先于公历节日
	var LUNAR_FESTIVALS = {
		"正月1": ["春节", "春节"], "正月15": ["元宵", "元宵节"], "五月5": ["端午", "端午节"],
		"七月7": ["七夕", "七夕节"], "八月15": ["中秋", "中秋节"], "九月9": ["重阳", "重阳节"],
		"腊月8": ["腊八", "腊八节"],
	};
	var SOLAR_FESTIVALS = {
		"1-1": ["元旦", "元旦"], "5-1": ["劳动", "劳动节"], "6-1": ["儿童", "儿童节"],
		"7-1": ["建党", "建党节"], "8-1": ["建军", "建军节"], "9-10": ["教师", "教师节"],
		"10-1": ["国庆", "国庆节"], "12-25": ["圣诞", "圣诞节"],
	};
	function festivalOf(date, lunar) {
		if (lunar) {
			var lf = LUNAR_FESTIVALS[lunar.month + lunar.day];
			if (lf) return lf;
			// 除夕 = 正月初一的前一天（腊月可能只有 29 天）
			var next = lunarOf(new Date(date.getFullYear(), date.getMonth(), date.getDate() + 1));
			if (next && next.month === "正月" && next.day === 1) return ["除夕", "除夕"];
		}
		var mm = date.getMonth() + 1, dd = date.getDate();
		var sf = SOLAR_FESTIVALS[mm + "-" + dd];
		if (sf) return sf;
		// 清明（节气）：21 世纪通用公式 [Y×0.2422+4.81]−[Y/4]，Y 为年份后两位
		var yy = date.getFullYear() % 100;
		if (mm === 4 && dd === Math.floor(yy * 0.2422 + 4.81) - Math.floor(yy / 4)) return ["清明", "清明"];
		return null;
	}
	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", initBento, { once: true });
	} else {
		initBento();
	}
</script>

<script is:inline>
	(function () {
		var box = document.getElementById("home-lrc");
		var mgr = window.__fireflyMusic;
		if (!box || !mgr) return;
		var cur = box.querySelector(".home-lrc-cur");
		var next = box.querySelector(".home-lrc-next");

		var lyrics = [];
		var index = -1;
		var status = "none";
		var playing = false;

		function show(a, b) {
			if (cur.textContent === a && next.textContent === b) return;
			cur.textContent = a;
			next.textContent = b;
			// 换句时重新触发淡入动画
			box.classList.remove("is-changing");
			void box.offsetWidth;
			box.classList.add("is-changing");
		}

		function render() {
			if (!playing && index < 0) return show("♪ 点一下播放，听听此刻的旋律", "");
			if (status === "loading") return show("歌词加载中…", "");
			if (!lyrics.length) return show("♪ 纯音乐，请欣赏", "");
			if (index < 0) return show("♪ 前奏…", lyrics[0].text);
			show(lyrics[index].text, lyrics[index + 1] ? lyrics[index + 1].text : "");
		}

		function sync() {
			var s = mgr.getState();
			lyrics = s.lyrics || [];
			index = s.currentLrcIndex;
			playing = !!s.isPlaying;
			render();
		}

		// 首页经 swup 进出时本脚本会重跑：离开首页后（歌词条已不在文档里）卸掉这一份监听
		var listeners = {
			"fm:lyrics": function (e) {
				lyrics = e.detail.lyrics || [];
				status = e.detail.status;
				index = -1;
				render();
			},
			"fm:lrc-index": function (e) {
				index = e.detail.index;
				render();
			},
			"fm:play-state": function (e) {
				playing = !!(e.detail && e.detail.isPlaying);
				render();
			},
			"fm:init": sync,
		};
		function unbind() {
			if (box.isConnected) return;
			Object.keys(listeners).forEach(function (name) {
				window.removeEventListener(name, listeners[name]);
			});
			document.removeEventListener("swup:page:view", unbind);
		}
		Object.keys(listeners).forEach(function (name) {
			window.addEventListener(name, listeners[name]);
		});
		document.addEventListener("swup:page:view", unbind);
		sync();
	})();
</script>

{/* 装饰性小天气：按访客 IP 定位城市，再查 Open-Meteo 当前天气。全部免 Key；
    结果在本次会话内缓存 30 分钟，任何一步失败都保持隐藏，不影响首页 */}
<script is:inline>
	(function () {
		var el = document.getElementById("bento-weather");
		if (!el) return;

		var CACHE_KEY = "bento-weather";
		var CACHE_MS = 30 * 60 * 1000;

		// WMO 天气代码 → [白天图标, 夜间图标, 描述]
		function describe(code) {
			if (code === 0) return ["☀️", "🌙", "晴"];
			if (code <= 2) return ["🌤️", "🌙", "少云"];
			if (code === 3) return ["☁️", "☁️", "阴"];
			if (code <= 48) return ["🌫️", "🌫️", "雾"];
			if (code <= 57) return ["🌦️", "🌧️", "毛毛雨"];
			if (code <= 67) return ["🌧️", "🌧️", "雨"];
			if (code <= 77) return ["❄️", "❄️", "雪"];
			if (code <= 82) return ["🌦️", "🌧️", "阵雨"];
			if (code <= 86) return ["🌨️", "🌨️", "阵雪"];
			return ["⛈️", "⛈️", "雷雨"];
		}

		function render(w) {
			var d = describe(w.code);
			el.textContent = (w.isDay ? d[0] : d[1]) + " " + (w.city ? w.city + " · " : "") + w.temp + "° " + d[2];
			el.title = "天气数据：Open-Meteo";
			el.hidden = false;
		}

		function getJSON(u) {
			var ctrl = typeof AbortController !== "undefined" ? new AbortController() : null;
			var timer = ctrl ? setTimeout(function () { ctrl.abort(); }, 8000) : null;
			return fetch(u, ctrl ? { signal: ctrl.signal } : undefined).then(function (r) {
				if (timer) clearTimeout(timer);
				if (!r.ok) throw new Error(r.status);
				return r.json();
			});
		}

		try {
			var cached = JSON.parse(sessionStorage.getItem(CACHE_KEY) || "null");
			if (cached && Date.now() - cached.at < CACHE_MS) {
				render(cached);
				return;
			}
		} catch (e) {}

		getJSON("https://get.geojs.io/v1/ip/geo.json")
			.then(function (geo) {
				var lat = Number(geo.latitude), lon = Number(geo.longitude);
				if (!isFinite(lat) || !isFinite(lon)) throw new Error("no location");
				var weather = getJSON(
					"https://api.open-meteo.com/v1/forecast?latitude=" + lat + "&longitude=" + lon +
					"&current=temperature_2m,weather_code,is_day&timezone=auto"
				);
				// IP 定位只给英文城市名，用 Open-Meteo 的地名搜索换成中文；
				// 取坐标最近（1° 以内）的同名地点，找不到就用原名
				var city = geo.city
					? getJSON(
						"https://geocoding-api.open-meteo.com/v1/search?count=5&language=zh&name=" +
						encodeURIComponent(geo.city)
					).then(function (r) {
						var best = null, bestDist = 1;
						(r.results || []).forEach(function (p) {
							var dist = Math.abs(p.latitude - lat) + Math.abs(p.longitude - lon);
							if (dist < bestDist) { best = p; bestDist = dist; }
						});
						return best ? best.name : geo.city;
					}).catch(function () { return geo.city; })
					: Promise.resolve("");
				return Promise.all([weather, city]);
			})
			.then(function (res) {
				var cur = res[0].current;
				if (!cur || typeof cur.temperature_2m !== "number") throw new Error("no weather");
				var w = {
					at: Date.now(),
					city: res[1],
					temp: Math.round(cur.temperature_2m),
					code: cur.weather_code,
					isDay: cur.is_day === 1,
				};
				try { sessionStorage.setItem(CACHE_KEY, JSON.stringify(w)); } catch (e) {}
				render(w);
			})
			.catch(function () {});
	})();
</script>
</div>

</Layout>
