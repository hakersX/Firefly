---
/**
 * 首页 index.astro —— 猫窝风格
 *
 *   首屏：CatHero      — 暖色天空 + 窗台猫咪剪影 + 名字/标语/入口按钮
 *   下方：CatAnnounce  — 气泡公告条
 *         CatStats     — 统计卡片
 *         CatChips     — 分类 / 标签胶囊
 *         CatSocial    — 社交链接
 */
import "@/components/home/cat-home.css";
import CatAnnounce from "@/components/home/CatAnnounce.astro";
import CatChips from "@/components/home/CatChips.astro";
import CatHero from "@/components/home/CatHero.astro";
import CatSocial from "@/components/home/CatSocial.astro";
import CatStats from "@/components/home/CatStats.astro";
import Navbar from "@/components/layout/Navbar.astro";
import {
	backgroundWallpaper,
	displaySettingsConfig,
	profileConfig,
	siteConfig,
} from "@/config";
import Layout from "@/layouts/Layout.astro";
import {
	getCategoryList,
	getSortedPostsList,
	getTagList,
} from "@/utils/content-utils";

const isBannerMode = backgroundWallpaper.mode === "banner";
const isFullscreenMode = backgroundWallpaper.mode === "fullscreen";
const isOverlayMode = backgroundWallpaper.mode === "overlay";
const isWallpaperSwitchable = displaySettingsConfig.wallpaperModeSwitchable;
const navbarWidthFull = siteConfig.navbar.widthFull ?? false;
const stickyNavbar = siteConfig.navbar.stickyNavbar ?? false;

const allPosts = await getSortedPostsList();
const categories = await getCategoryList();
const tags = await getTagList();

const visiblePosts = allPosts.filter((p) =>
	import.meta.env.PROD ? !p.data.draft : true,
);

const postCount = visiblePosts.length;
const categoryCount = categories.length;
const tagCount = tags.length;
const startDate = new Date(siteConfig.siteStartDate ?? "2026-01-01");
const today = new Date();
const runningDays = Math.max(
	0,
	Math.floor((today.getTime() - startDate.getTime()) / 86400000),
);

const announcementMessages = [
	"喵~ 欢迎来到猫神X的猫窝",
	`猫窝里已经囤了 ${postCount} 篇文章 · ${categoryCount} 个分区 · ${tagCount} 个标签`,
	"记录技术 · 分享生活 · 偶尔讲故事",
	`猫窝已经营业 ${runningDays} 天啦`,
];

const stats = [
	{ icon: "material-symbols:article", target: postCount, label: "文章", url: "/articles/" },
	{
		icon: "material-symbols:folder-open-rounded",
		target: categoryCount,
		label: "分类",
		url: "/categories/",
	},
	{ icon: "material-symbols:tag-rounded", target: tagCount, label: "标签", url: "/tags/" },
	{
		icon: "material-symbols:calendar-month-rounded",
		target: runningDays,
		label: "营业天数",
		url: "/archive/",
	},
];
---

<Layout
	title={siteConfig.title}
	hasWallpaper={isWallpaperSwitchable || isBannerMode || isFullscreenMode || isOverlayMode}
>

{/* 顶部导航栏（保留） */}
<div
	id="top-row"
	class="z-50 pointer-events-none relative transition-all duration-700 mx-auto"
	class:list={[
		stickyNavbar ? "h-18 fixed top-0 left-0 right-0 z-80" : "",
		navbarWidthFull ? "" : "w-full xl:w-[92vw] max-w-(--page-width) px-0 md:px-4",
	]}
>
	<div
		id="navbar-wrapper"
		class:list={["pointer-events-auto transition-all", stickyNavbar ? "" : "sticky top-0"]}
	>
		<Navbar></Navbar>
	</div>
</div>

<div class="cat-home">
	<CatHero
		name={profileConfig.name}
		slogan="躬身入局，心为主理，行有尺度"
		subtitle="欢迎来到猫神X的猫窝"
	/>

	<CatAnnounce messages={announcementMessages} />
	<CatStats stats={stats} />
	<CatChips kind="categories" title="猫窝分区" subtitle="按主题逛逛文章" items={categories} />
	<CatChips kind="tags" title="猫薄荷标签" subtitle="点一个标签，找到相关的文章" items={tags} />
	<CatSocial title="来找我玩" links={profileConfig.links} />

	<footer class="cat-footer">
		<p>&copy; {new Date().getFullYear()} {siteConfig.title} &middot; 猫猫已就位 🐾</p>
	</footer>
</div>

<script is:inline>
	function initReveal() {
		var reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
		var reveals = Array.from(document.querySelectorAll(".reveal:not(.is-visible)"));
		if (reveals.length === 0) return;

		if (reduceMotion) {
			reveals.forEach(function (el) { el.classList.add("is-visible"); });
			return;
		}

		var io = new IntersectionObserver(
			function (entries) {
				for (var i = 0; i < entries.length; i++) {
					if (entries[i].isIntersecting) {
						entries[i].target.classList.add("is-visible");
						io.unobserve(entries[i].target);
					}
				}
			},
			{ threshold: 0.08, rootMargin: "0px 0px -10% 0px" }
		);
		reveals.forEach(function (el) { io.observe(el); });
	}

	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", initReveal, { once: true });
	} else {
		initReveal();
	}
	document.addEventListener("swup:contentReplaced", initReveal);
</script>

</Layout>
